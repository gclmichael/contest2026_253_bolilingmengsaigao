<template>
  <div class="screen">
    <text class="title">智能复习窗口</text>
    <div class="toggle-row">
      <div>
        <text class="toggle-title">低压力时推荐</text>
        <text class="toggle-copy">仅在你主动开启后运行</text>
      </div>
      <switch checked="{{ enabled }}" onchange="toggle" style="thumb-color: #d8ff58; track-color: #354323;"></switch>
    </div>

    <div class="signals">
      <div class="signal">
        <text class="signal-label">压力</text>
        <text class="signal-value">{{ stressText }}</text>
      </div>
      <div class="signal">
        <text class="signal-label">活动</text>
        <text class="signal-value">{{ motionText }}</text>
      </div>
    </div>

    <div class="decision {{ ready ? 'ready' : '' }}">
      <text class="decision-label">当前判断</text>
      <text class="decision-text">{{ decision }}</text>
    </div>

    <text class="profile">个人阈值 {{ stressMax }} · 接受率 {{ acceptanceRate }}%</text>
    <div if="{{ ready }}" class="recommend-actions">
      <a class="primary compact" href="/pages/quiz" onclick="acceptRecommendation">开始复习</a>
      <div class="later" onclick="dismissRecommendation"><text class="later-text">稍后</text></div>
    </div>
    <a class="back" href="/">返回首页</a>
    <text class="note">压力数据仅用于选择提醒时机</text>
  </div>
</template>

<script>
import contextMonitor from '../../common/context_monitor.js';

export default {
  private: {
    enabled: false,
    monitoring: false,
    stress: null,
    stressText: '--',
    accelSamples: [],
    motionText: '等待数据',
    decision: '开启后判断复习窗口',
    ready: false,
    stressMax: 25,
    acceptanceRate: 0,
    unsubscribe: null,
  },
  onReady() {
    this.unsubscribe = contextMonitor.subscribe((value) => this.applySnapshot(value));
    contextMonitor.start().catch(() => {});
  },
  onDestroy() {
    if (this.unsubscribe) this.unsubscribe();
  },
  async toggle(event) {
    await contextMonitor.setEnabled(!!event.checked);
  },
  applySnapshot(value) {
    this.enabled = value.enabled;
    this.monitoring = value.monitoring;
    this.stressText = value.stressText;
    this.motionText = value.motionText;
    this.decision = value.decision;
    this.ready = value.ready;
    this.stressMax = value.stressMax;
    this.acceptanceRate = value.acceptanceRate;
  },
  acceptRecommendation() {
    contextMonitor.recordFeedback(true).catch(() => {});
  },
  dismissRecommendation() {
    contextMonitor.recordFeedback(false).catch(() => {});
  },
};
</script>

<style>
.screen { width: 480px; height: 480px; padding: 34px 54px 22px; flex-direction: column; background-color: #101311; color: #f4f6f0; }
.title { width: 372px; font-size: 30px; font-weight: 700; text-align: center; color: #ffffff; }
.toggle-row { margin-top: 18px; width: 372px; height: 64px; flex-direction: row; align-items: center; justify-content: space-between; }
.toggle-title { font-size: 21px; font-weight: 700; color: #ffffff; }
.toggle-copy { margin-top: 4px; font-size: 14px; color: #8f9890; }
.signals { margin-top: 14px; width: 372px; height: 78px; flex-direction: row; justify-content: space-between; }
.signal { width: 178px; height: 78px; padding: 12px 16px; border-width: 1px; border-color: #3c443d; border-radius: 8px; background-color: #1a1f1b; }
.signal-label { font-size: 15px; color: #8f9890; }
.signal-value { margin-top: 5px; font-size: 25px; font-weight: 700; color: #ffffff; }
.decision { margin-top: 14px; width: 372px; height: 78px; padding: 11px 16px; border-width: 1px; border-color: #4b554d; border-radius: 8px; background-color: #1b201c; }
.decision-label { font-size: 14px; color: #8f9890; }
.decision-text { margin-top: 5px; font-size: 19px; color: #e8ece6; lines: 2; text-overflow: ellipsis; }
.ready { border-color: #d8ff58; background-color: #253016; }
.profile { margin-top: 7px; width: 372px; font-size: 13px; text-align: center; color: #8f9890; }
.recommend-actions { margin-top: 8px; width: 372px; height: 44px; flex-direction: row; justify-content: space-between; }
.primary { margin-top: 14px; width: 372px; height: 48px; border-radius: 8px; background-color: #d8ff58; justify-content: center; align-items: center; font-size: 19px; font-weight: 700; text-align: center; color: #111510; }
.compact { margin-top: 0; width: 264px; height: 44px; }
.later { width: 96px; height: 44px; border-width: 1px; border-color: #5c665e; border-radius: 8px; justify-content: center; align-items: center; }
.later-text { font-size: 17px; color: #d4d9d2; }
.back { margin-top: 8px; width: 372px; height: 38px; border-width: 1px; border-color: #485149; border-radius: 8px; justify-content: center; align-items: center; font-size: 16px; text-align: center; color: #d4d9d2; }
.note { margin-top: 8px; width: 372px; font-size: 13px; text-align: center; color: #767e77; }
</style>
